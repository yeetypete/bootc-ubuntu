#!/usr/bin/env python3
r"""Install this image onto a disk, with a LUKS2-encrypted root.

Partitions the disk according to /usr/lib/bootc-ubuntu/repart.d, encrypts the
root with a passphrase, and installs the image into it. Normally run this from
a live ISO, which either embeds the bootc image or pulls it from its registry:

    bootc-ubuntu-install /dev/nvme0n1

You may also run `bootc-ubuntu-install` from the image as a container, against
a disk on the host:

    podman run --rm -it --privileged --pid=host --ipc=host \\
      -v /dev:/dev -v /run/udev:/run/udev:ro \\
      IMAGE bootc-ubuntu-install /dev/nvme0n1 IMGREF
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from getpass import getpass
from pathlib import Path

# Discoverable Partitions Specification type GUIDs, as written by repart.d.
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
ROOT_TYPE = "4f68bce3-e8cd-4db1-96e7-fbcaf984b709"

DEFINITIONS = Path("/usr/lib/bootc-ubuntu/repart.d")
MAPPING = "bootc-ubuntu-root"

# dracut's dmsquash-live mounts the ISO here: where an install off the live
# media finds the image, if embedded, and the registry it updates from.
LIVE_MEDIA = Path("/run/initramfs/live")
LIVE_OCI = LIVE_MEDIA / "image.oci"
LIVE_IMGREF = LIVE_MEDIA / "image.ref"

# bootc stages the source image here, and containers/image hardcodes the path
# rather than honouring TMPDIR.
SCRATCH = Path("/var/tmp")
SCRATCH_NEEDED = 128 * 1024**2


def partition_of_type(device: Path, type_guid: str) -> Path:
    """Find a partition by its type GUID."""
    out = subprocess.run(
        ["lsblk", "--json", "--list", "--output", "PATH,PARTTYPE", device],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    for part in json.loads(out)["blockdevices"]:
        if (part.get("parttype") or "").lower() == type_guid:
            return Path(part["path"])
    sys.exit(f"no partition of type {type_guid} on {device}.")


def prompt_passphrase() -> str:
    passphrase = getpass("Passphrase for the encrypted root: ")
    if not passphrase:
        sys.exit("Passphrase must not be empty.")
    if passphrase != getpass("Repeat passphrase: "):
        sys.exit("Passphrases do not match.")
    return passphrase


def confirm(device: Path) -> None:
    print(f"This destroys every partition on {device}:")
    subprocess.run(["lsblk", "--output", "NAME,SIZE,FSTYPE,LABEL", device], check=False)
    if input(f"Type {device} to confirm: ").strip() != str(device):
        sys.exit("Aborted.")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("device", type=Path, help="Disk to install to.")
    parser.add_argument(
        "source_imgref",
        nargs="?",
        default=None,
        help="Image to install, in containers-transports(5) form, such as "
        "docker://docker.io/example/bootc-ubuntu:26.04. Defaults to the ISO's "
        "embedded image if it has one, otherwise pulls the ISO's own image "
        "from its registry.",
    )
    parser.add_argument(
        "target_imgref",
        nargs="?",
        help="Registry reference the installed system fetches updates from, such "
        "as docker.io/example/bootc-ubuntu:26.04.",
    )
    parser.add_argument(
        "--reboot",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="Reboot once the installation finishes. An installation from the "
        "live media asks on a terminal and reboots without one. Anywhere else "
        "it defaults to not rebooting.",
    )
    return parser.parse_args()


def resolve_imgrefs(
    source_imgref: str | None,
    target_imgref: str | None,
) -> tuple[str, str]:
    """Fall back to the image the live ISO was built with, and its registry."""
    live_imgref = LIVE_IMGREF.read_text().strip() if LIVE_IMGREF.exists() else ""
    if not source_imgref:
        if not live_imgref:
            sys.exit("no source image given, and this live ISO does not record one.")
        if LIVE_OCI.exists():
            tag = live_imgref.rsplit(":", 1)[1]
            source_imgref = f"oci:{LIVE_OCI}:{tag}"
        else:
            source_imgref = f"docker://{live_imgref}"
    return source_imgref, target_imgref or live_imgref


def install(
    device: Path,
    source_imgref: str,
    target_imgref: str,
    keyfile: Path,
    target: Path,
) -> None:
    print(f"Partitioning {device}")
    subprocess.run(
        [
            "systemd-repart",
            f"--definitions={DEFINITIONS}",
            "--empty=force",
            "--dry-run=no",
            f"--key-file={keyfile}",
            device,
        ],
        check=True,
        # composefs verifies the deployment with fs-verity, and repart does not
        # enable the ext4 feature by default.
        env=os.environ | {"SYSTEMD_REPART_MKFS_OPTIONS_EXT4": "-O verity"},
    )
    subprocess.run(["udevadm", "settle"], check=True)

    esp = partition_of_type(device, ESP_TYPE)
    root = partition_of_type(device, ROOT_TYPE)

    print(f"Unlocking {root}")
    subprocess.run(
        ["cryptsetup", "luksOpen", root, MAPPING, f"--key-file={keyfile}"],
        check=True,
    )
    subprocess.run(["mount", f"/dev/mapper/{MAPPING}", target], check=True)

    extra: list[str] = []
    if target_imgref:
        extra.append(f"--target-imgref={target_imgref}")
    elif not source_imgref.startswith(("docker://", "registry:")):
        print(
            "Warning: no target_imgref and source_imgref is not a registry "
            "reference, so the installed system will have no usable update source.",
            file=sys.stderr,
        )

    print(f"Installing {source_imgref}")
    subprocess.run(
        [
            "bootc",
            "install",
            "to-filesystem",
            "--composefs-backend",
            f"--source-imgref={source_imgref}",
            "--skip-fetch-check",
            *extra,
            target,
        ],
        check=True,
    )

    print(f"\nInstalled. ESP {esp}, encrypted root {root}.")
    print("Add a TPM2 keyslot once Secure Boot is enabled with:")
    print(f"  systemd-cryptenroll --tpm2-device=auto {root}.")


def should_reboot(explicit: bool | None) -> bool:
    """Finish an installation from the live media by rebooting."""
    if explicit is not None:
        return explicit
    if not LIVE_MEDIA.is_dir():
        return False
    if not sys.stdin.isatty():
        return True
    return input("\nReboot now? [Y/n] ").strip().lower() in ("", "y", "yes")


def main() -> None:
    args = parse_args()
    source_imgref, target_imgref = resolve_imgrefs(
        args.source_imgref,
        args.target_imgref,
    )

    if os.geteuid() != 0:
        sys.exit("This script must run as root.")
    if not args.device.is_block_device():
        sys.exit(f"{args.device} is not a block device.")

    free = shutil.disk_usage(SCRATCH).free
    if free < SCRATCH_NEEDED:
        sys.exit(
            f"{SCRATCH} has {free // 1024**2}M free, the install needs about "
            f"{SCRATCH_NEEDED // 1024**2}M there. Mount more space and retry.",
        )

    confirm(args.device)
    passphrase = prompt_passphrase()

    with tempfile.TemporaryDirectory() as tmp:
        # repart takes the key from a file. Writing the passphrase with no
        # trailing newline makes the resulting keyslot an ordinary passphrase.
        keyfile = Path(tmp) / "passphrase"
        keyfile.write_text(passphrase)
        keyfile.chmod(0o600)

        target = Path(tmp) / "target"
        target.mkdir()
        try:
            install(args.device, source_imgref, target_imgref, keyfile, target)
        finally:
            subprocess.run(["umount", "--recursive", target], check=False)
            subprocess.run(["cryptsetup", "close", MAPPING], check=False)

    if should_reboot(args.reboot):
        print("Remove the installation medium. Rebooting.")
        subprocess.run(["systemctl", "reboot"], check=True)
    elif LIVE_MEDIA.is_dir():
        print("\nRemove the installation medium and reboot into the new system.")
    else:
        print(f"\nBoot {args.device} to start the new system.")


if __name__ == "__main__":
    main()
