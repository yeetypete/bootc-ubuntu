#!/usr/bin/env python3
"""Build-time tooling for bootc-ubuntu images.

After installing packages and copying configuration in, finish the Containerfile
with:

    RUN /usr/libexec/bootc-ubuntu-imagectl finalize
"""

import argparse
import errno
import functools
import grp
import json
import os
import pwd
import shutil
import stat
import subprocess
import sys
from collections import Counter, defaultdict
from pathlib import Path, PurePosixPath
from typing import TYPE_CHECKING, NamedTuple, NoReturn

if TYPE_CHECKING:
    from collections.abc import Callable, Iterator

# --- Image layout ---


MODULES = Path("/usr/lib/modules")
STOCK_TMPFILES = Path("/usr/lib/tmpfiles.d")
VAR_TMPFILES = STOCK_TMPFILES / "bootc-ubuntu-var.conf"
DPKG_ADMINDIR = Path("/var/lib/dpkg")
SYSIMAGE = Path("/usr/lib/sysimage")

# Package manager state that describes the image. It lives under /usr
# so it survives updates. Symlinks put it back where programs expect it.
IMAGE_STATE = {
    DPKG_ADMINDIR: SYSIMAGE / "dpkg",
    Path("/var/lib/pam"): SYSIMAGE / "pam",
    Path("/var/lib/ucf"): SYSIMAGE / "ucf",
    Path("/var/cache/debconf"): SYSIMAGE / "debconf",
    Path("/var/lib/systemd/deb-systemd-helper-enabled"): SYSIMAGE
    / "deb-systemd-helper-enabled",
    Path("/var/lib/systemd/deb-systemd-user-helper-enabled"): SYSIMAGE
    / "deb-systemd-user-helper-enabled",
}

# Toplevel symlinks, following a bootc/ostree layout. tmpfiles.d creates
# their targets at boot.
TOPLEVEL_LINKS = {
    Path("/home"): "var/home",
    Path("/root"): "var/roothome",
    Path("/srv"): "var/srv",
    Path("/mnt"): "var/mnt",
    Path("/media"): "run/media",
    Path("/ostree"): "sysroot/ostree",
}

# Symlinks systemd recreates at boot, kept so a derived image has them between
# finalize and its own package installs.
VAR_LINKS = {
    Path("/var/run"): "../run",
    Path("/var/lock"): "../run/lock",
}

# What a finalized image keeps in /var, and the mode to keep it at. tmpfiles.d
# recreates these directories at boot.
VAR_DIRS = {
    # dracut refuses to run without a tmpdir.
    Path("/var/tmp"): 0o1777,
    # apt exits 100 on a missing /var/log.
    Path("/var/log/apt"): 0o755,
}

# Directories a program initializes itself and should not be
# created automatically with tmpfiles entries.
VAR_SELF_INITIALIZED = (Path("/var/lib/flatpak/repo"),)

VAR = Path("/var")

# Where `podman run --mount=type=image` presents the rootfs to rechunk.
CHUNKAH_ROOTFS = Path("/chunkah")


# --- Helpers ---


def fail(message: str) -> NoReturn:
    """Exit with a message naming this tool."""
    sys.exit(f"bootc-ubuntu-imagectl: {message}")


def step(message: str) -> None:
    """Report the step about to run."""
    print(f"bootc-ubuntu-imagectl: {message}", file=sys.stderr, flush=True)


def dropin_fields(*directories: Path, skip: Path | None = None) -> Iterator[list[str]]:
    """Split the meaningful lines of the .conf drop-ins in some directories.

    systemd reads a drop-in directory in filename order, which is what decides
    precedence for both tmpfiles.d and sysusers.d, so the files are walked
    sorted.

    Args:
        directories: The drop-in directories to read, in order.
        skip: A file to leave out, for a caller reading back its own output.

    Yields:
        The whitespace-separated fields of each line that carries any.
    """
    for directory in directories:
        if not directory.is_dir():
            continue
        for conf in sorted(directory.glob("*.conf")):
            if conf == skip:
                continue
            for line in conf.read_text().splitlines():
                if line.startswith("#"):
                    continue
                fields = line.split()
                if fields:
                    yield fields


def summary(command: Callable[[Args], None]) -> str:
    """Summarise a subcommand for --help.

    Returns:
        The first line of its docstring.
    """
    doc = command.__doc__
    return doc.splitlines()[0] if doc else ""


# --- Kernel and initramfs ---


def kernel_version() -> str:
    """Find the kernel the image ships. bootc requires exactly one.

    Returns:
        The kernel version.
    """
    kvers: list[str] = (
        sorted(p.name for p in MODULES.iterdir() if p.is_dir())
        if MODULES.is_dir()
        else []
    )
    if len(kvers) != 1:
        fail(
            f"expected exactly one kernel in {MODULES}, found: {' '.join(kvers) or 'none'}."
        )
    return kvers[0]


def cmd_initramfs(args: Args) -> None:
    """Build the initramfs and stage the kernel under /usr/lib/modules."""
    kver = kernel_version()
    moddir = MODULES / kver
    step(f"building the initramfs for {kver}")

    # bootc looks for the kernel at /usr/lib/modules/<kver>/vmlinuz, where the
    # Ubuntu package does not put it.
    boot_vmlinuz = Path(f"/boot/vmlinuz-{kver}")
    if boot_vmlinuz.is_file():
        boot_vmlinuz.copy(moddir / "vmlinuz", preserve_metadata=True)
    if not (moddir / "vmlinuz").is_file():
        fail(f"no kernel image for {kver}")

    subprocess.run(["depmod", kver], check=True)
    subprocess.run(
        [
            "dracut",
            "--force",
            "--no-hostonly",
            "--reproducible",
            "--zstd",
            "--verbose",
            "--kver",
            kver,
            str(moddir / "initramfs.img"),
        ],
        check=True,
    )
    (moddir / "initramfs.img").chmod(0o600)


# --- Component labelling ---


# Recorded path to source package.
type Owners = dict[str, str]
# Directory to the source package owning its whole subtree.
type Components = dict[PurePosixPath, str]


class LabelCounts(NamedTuple):
    """What one labelling pass touched."""

    files: int
    unclaimed_symlinks: int


COMPONENT_XATTR = "user.component"

# dpkg-query interprets the backslash escapes itself.
QUERY_FORMAT = r"${binary:Package}\t${source:Package}\t${db:Status-Status}\n"

# States in which a package's files are on disk. One awaiting a trigger still
# counts as installed.
INSTALLED_STATES = frozenset({"installed", "triggers-awaiting", "triggers-pending"})


def source_packages(admindir: Path) -> dict[str, str]:
    """Map each installed binary package to its source package.

    Returns:
        Each binary package name and its source.
    """
    listing = subprocess.run(
        ["dpkg-query", f"--admindir={admindir}", "-f", QUERY_FORMAT, "-W"],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    ).stdout
    packages = {}
    for line in listing.splitlines():
        binary, source, status = line.split("\t")
        if status in INSTALLED_STATES:
            packages[binary] = source
    return packages


@functools.cache
def canonical_dir(directory: Path) -> Path:
    """Resolve the merged-/usr aliases, so /lib/firmware is /usr/lib/firmware.

    Without this the few packages still recording paths under /lib look like
    the sole owners of /lib, and labelling it labels /usr/lib.

    Returns:
        The resolved directory.
    """
    return directory.resolve()


def owned_paths(admindir: Path, source_of: dict[str, str]) -> tuple[Owners, list[str]]:
    """Map every file and symlink dpkg records to its source package.

    Directories are skipped, since dpkg lists a shared one under every package
    installing into it. So are absent paths, which the base image's dpkg
    excludes drop.

    Returns:
        The owned paths, and the packages with no known source.
    """
    owners: Owners = {}
    unknown = []
    for list_file in sorted(admindir.glob("info/*.list")):
        source = source_of.get(list_file.stem)
        if source is None:
            unknown.append(list_file.stem)
            continue
        # surrogateescape preserves paths that are not valid UTF-8.
        listed = list_file.read_text(encoding="utf-8", errors="surrogateescape")
        for line in listed.splitlines():
            entry = Path(line)
            info = entry.info
            if info.is_file(follow_symlinks=False) or info.is_symlink():
                owners[str(canonical_dir(entry.parent) / entry.name)] = source
    return owners, unknown


def wholly_owned_dirs(owners: Owners) -> Components:
    """Find the topmost directories whose recorded contents come from one source.

    chunkah applies a directory's component to everything beneath it, so one
    xattr here stands in for thousands below.

    Returns:
        Each directory and the source owning it.
    """
    sources: dict[PurePosixPath, set[str]] = defaultdict(set)
    for path, source in owners.items():
        for directory in PurePosixPath(path).parents:
            sources[directory].add(source)

    owned = {d for d, s in sources.items() if len(s) == 1}
    return {d: next(iter(sources[d])) for d in owned if d.parent not in owned}


def label(path: str | os.PathLike[str], source: str) -> None:
    """Tag a path with the component chunkah should pack it with."""
    os.setxattr(path, COMPONENT_XATTR, source.encode())


def apply_labels(owners: Owners, components: Components) -> LabelCounts:
    """Write the component xattr onto each directory and the paths it misses.

    Returns:
        What the pass labelled and what it could not.
    """
    for directory, source in components.items():
        label(directory, source)

    files = symlinks = 0
    for path, source in owners.items():
        if any(d in components for d in PurePosixPath(path).parents):
            continue
        if Path(path).is_symlink():
            # The kernel rejects user.* xattrs on symlinks.
            symlinks += 1
            continue
        label(path, source)
        files += 1
    return LabelCounts(files, symlinks)


def label_components(admindir: Path) -> None:
    """Label package-owned paths with the source package that owns them.

    chunkah then splits the image into content-based layers instead of one
    layer per build stage.

    TODO: switch to chunkah's native dpkg backend and drop this once
    https://github.com/coreos/chunkah/issues/155 lands.
    """
    step("labelling files with the package that owns them")
    owners, unknown = owned_paths(admindir, source_packages(admindir))
    for package in unknown:
        print(
            f"No source package for {package}, leaving its files unclaimed.",
            file=sys.stderr,
        )

    components = wholly_owned_dirs(owners)
    files, symlinks = apply_labels(owners, components)
    if not components and not files:
        fail(f"nothing to label under {admindir}")

    # The kernel image and initramfs are generated, not shipped by a package.
    # Pack them with the kernel's modules.
    moddir = MODULES / kernel_version()
    kernel_sources = Counter(
        source for path, source in owners.items() if Path(path).is_relative_to(moddir)
    )
    if kernel_sources:
        kernel_source, _ = kernel_sources.most_common(1)[0]
        for name in ("vmlinuz", "initramfs.img"):
            if (moddir / name).is_file():
                label(moddir / name, kernel_source)

    print(
        f"Labelled {len(set(owners.values()))} components as "
        f"{len(components)} directories and {files} files."
    )
    if symlinks:
        print(f"{symlinks} unclaimed symlinks have no labelled directory above them.")


# --- Rootfs layout ---


def relocate_image_state() -> None:
    """Move package manager state to /usr, see IMAGE_STATE."""
    step("relocating package manager state to /usr/lib/sysimage")
    SYSIMAGE.mkdir(parents=True, exist_ok=True)
    for source, target in IMAGE_STATE.items():
        if source.is_symlink():
            continue
        if source.is_dir():
            source.move(target)
        else:
            target.mkdir(exist_ok=True)


def remove_machine_identity() -> None:
    """Delete what package postinstalls generate per machine at build time."""
    step("removing machine identity")
    # Empty so systemd generates one on first boot rather than every install
    # sharing this one.
    Path("/etc/machine-id").write_text("")

    # Let sshd-keygen generate unique per-machine host keys on first boot.
    for key in Path("/etc/ssh").glob("ssh_host_*"):
        key.unlink()

    # Let ssl-cert.service generate a unique per-machine snakeoil keypair on
    # first boot.
    for link in Path("/etc/ssl/certs").iterdir():
        if link.is_symlink() and link.readlink() == Path("ssl-cert-snakeoil.pem"):
            link.unlink()
    Path("/etc/ssl/certs/ssl-cert-snakeoil.pem").unlink(missing_ok=True)
    Path("/etc/ssl/private/ssl-cert-snakeoil.key").unlink(missing_ok=True)

    # Drop the empty /etc/resolv.conf the base image ships so systemd can
    # symlink it to the resolved stub at boot. podman run bind-mounts one in,
    # unlike podman build, and that one is not part of the image.
    resolv = Path("/etc/resolv.conf")
    if not resolv.is_mount():
        resolv.unlink(missing_ok=True)

    # Remove the placeholder fstab too, or bootc's /etc overlay makes libmount
    # warn "fstab has been modified" at boot.
    Path("/etc/fstab").unlink(missing_ok=True)

    # Backups and the lock the account tools leave behind, and the metadata
    # rockcraft leaves in the Ubuntu image.
    for name in ("passwd", "group", "shadow", "gshadow", "subuid", "subgid"):
        Path(f"/etc/{name}-").unlink(missing_ok=True)
    Path("/etc/.pwd.lock").unlink(missing_ok=True)
    shutil.rmtree("/.rock", ignore_errors=True)


def layout_toplevel() -> None:
    """Lay out the ostree-style toplevel directories and symlinks."""
    step("laying out the toplevel")
    for link, target in TOPLEVEL_LINKS.items():
        if link.is_symlink():
            link.unlink()
        elif link.exists():
            shutil.rmtree(link)
        link.symlink_to(target)

    # Create /boot/EFI/Linux because the composefs digest sealed into the UKI
    # excludes the UKI but not its parent directory.
    shutil.rmtree("/boot", ignore_errors=True)
    Path("/boot/EFI/Linux").mkdir(parents=True)
    Path("/sysroot").mkdir(exist_ok=True)
    Path("/var").mkdir(exist_ok=True)


def patch_stock_tmpfiles() -> None:
    """Reconcile systemd's stock tmpfiles.d with the ostree-style toplevel."""
    step("patching stock tmpfiles.d entries")
    # "Q /home" and "q /srv" fight the /home -> /var/home and /srv -> /var/srv
    # symlinks, and nothing else in the file applies.
    (STOCK_TMPFILES / "home.conf").unlink(missing_ok=True)

    # The credential provisioning entries write to /root, a symlink to
    # /var/roothome. Rewriting the paths keeps the rest of the file working.
    provision = STOCK_TMPFILES / "provision.conf"
    if provision.is_file():
        patched = provision.read_text().replace(" /root", " /var/roothome")
        # bootc-ubuntu-base-dirs.conf declares /var/roothome already, and
        # systemd warns about the duplicate at boot.
        kept = [
            line
            for line in patched.splitlines()
            if not line.startswith("d- /var/roothome ")
        ]
        provision.write_text("\n".join(kept) + "\n")


def relocate_font_cache() -> None:
    """Build the font cache, which a conf.d drop-in puts under /usr.

    The stock /var/cache/fontconfig would not reach an installed system, which
    starts with /var empty.
    """
    if shutil.which("fc-cache") is None:  # absent outside desktop images
        return
    step("building the font cache")
    subprocess.run(["fc-cache", "--system-only", "--force"], check=True)


# --- Generated /var tmpfiles.d ---


# systemd splits the line on whitespace and unquotes it, then expands "%"
# specifiers in what is left, so both have to be written escaped.
TMPFILES_ESCAPES = {ord(char): f"\\x{ord(char):02x}" for char in " \t\n\v\f\r\\'\""} | {
    ord("%"): "%%"
}


def tmpfiles_path(directory: Path) -> str:
    """Escape a path for the path field of a tmpfiles.d line.

    Returns:
        The path, as it appears in a tmpfiles.d file.
    """
    return str(directory).translate(TMPFILES_ESCAPES)


def declared_paths() -> set[str]:
    """Collect every path some other tmpfiles.d file already declares.

    systemd warns about a duplicate and ignores one of the two, so the
    generated entries skip these.

    Returns:
        The declared paths.
    """
    declared = set()
    for fields in dropin_fields(
        STOCK_TMPFILES, Path("/etc/tmpfiles.d"), skip=VAR_TMPFILES
    ):
        if len(fields) >= 2:
            declared.add(fields[1])
    return declared


def var_entry(path: str, mode: int, user: str, group: str) -> str:
    """Format one tmpfiles.d directory entry.

    Returns:
        The entry as a line.
    """
    return f"d {path} {mode:04o} {user} {group} -"


def name_of(uid: int, gid: int) -> tuple[str, str]:
    """Resolve an owning user and group, falling back to their numeric ids.

    Returns:
        The user and group names.
    """
    try:
        user = pwd.getpwuid(uid).pw_name
    except KeyError:
        user = str(uid)
    try:
        group = grp.getgrgid(gid).gr_name
    except KeyError:
        group = str(gid)
    return user, group


def write_var_tmpfiles() -> None:
    """Record what the image ships in /var, for tmpfiles.d to recreate.

    /var is only applied at first provisioning, so a directory a package put
    there is gone on an updated system unless something recreates it.
    """
    step("generating /var tmpfiles.d entries")
    declared = declared_paths()
    entries: dict[str, str] = {}

    # Entries an earlier finalize generated. That run emptied the directories
    # they describe, so scanning alone would drop them.
    if VAR_TMPFILES.is_file():
        for line in VAR_TMPFILES.read_text().splitlines():
            fields = line.split()
            if len(fields) >= 2 and not line.startswith("#"):
                entries[fields[1]] = line

    for directory in VAR.rglob("*"):
        if directory.is_symlink() or not directory.is_dir():
            continue
        path = tmpfiles_path(directory)
        if path in declared:
            continue
        info = directory.lstat()
        user, group = name_of(info.st_uid, info.st_gid)
        entries[path] = var_entry(path, stat.S_IMODE(info.st_mode), user, group)

    # relocate_image_state moved these to /usr before the scan ran, so nothing
    # above can see them. Written last so they win over any directory entry.
    for link, target in IMAGE_STATE.items():
        path = tmpfiles_path(link)
        entries[path] = f"L+ {path} - - - - {tmpfiles_path(target)}"

    for excluded in map(tmpfiles_path, VAR_SELF_INITIALIZED):
        prefix = f"{excluded}/"
        for path in [p for p in entries if p == excluded or p.startswith(prefix)]:
            del entries[path]

    header = (
        "# What the image ships in /var, which starts empty on an installed\n"
        "# system. Generated by bootc-ubuntu-imagectl.\n"
    )
    VAR_TMPFILES.write_text(
        header + "\n".join(entries[k] for k in sorted(entries)) + "\n"
    )
    print(f"Recorded {len(entries)} /var entries in {VAR_TMPFILES}.")


def empty_var() -> None:
    """Strip /var, /run and /tmp of everything tmpfiles.d recreates at boot.

    Raises:
        OSError: If a path cannot be removed, other than a mount podman put
            under /run or /tmp.
    """
    step("emptying /var, /run and /tmp")
    for directory in (Path("/run"), Path("/tmp")):
        for entry in directory.iterdir():
            try:
                if entry.is_dir() and not entry.is_symlink():
                    shutil.rmtree(entry)
                else:
                    entry.unlink()
            except OSError as error:
                # podman bind-mounts /run/.containerenv and /run/secrets into
                # the build.
                if error.errno != errno.EBUSY:
                    raise

    for entry in sorted(VAR.rglob("*"), reverse=True):
        if entry.is_dir() and not entry.is_symlink():
            entry.rmdir()
        else:
            entry.unlink()

    for directory, mode in VAR_DIRS.items():
        directory.mkdir(parents=True)
        directory.chmod(mode)
    for link, target in VAR_LINKS.items():
        link.symlink_to(target)
    for link, target in IMAGE_STATE.items():
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(target)


# --- Account declarations ---


SYSUSERS_D = Path("/usr/lib/sysusers.d")
# Where the declarations this tool generates go, alongside the ones packages
# ship. Read back on a later run, so a derived image declares only what it added.
#
# systemd takes the first declaration of a name across the directory in
# filename order, so the prefix is what lets a pinned id here win over the
# dynamic one a package declares.
GENERATED_SYSUSERS = SYSUSERS_D / "00-bootc-ubuntu-accounts.conf"
USERDB = Path("/usr/lib/userdb")
NSSWITCH = Path("/etc/nsswitch.conf")
LOGIN_DEFS = Path("/etc/login.defs")

# The ids each build is expected to allocate, as drop-ins a derived image can
# add to. A build that allocates something else fails rather than shipping the
# drift, since sysusers never renumbers an account a machine already has.
REGISTRY_D = Path("/usr/lib/bootc-ubuntu/accounts.d")

# Where an id can end up recorded numerically, so that an account owning
# something here has to keep the same id on every machine that runs the image.
OWNED_TREES = (Path("/usr"), Path("/etc"))
ETC = Path("/etc")

# Where the generated chown-by-name entries go.
CHOWN_TMPFILES = STOCK_TMPFILES / "bootc-ubuntu-accounts.conf"

PASSWD = Path("/etc/passwd")
GROUP = Path("/etc/group")
SHADOW = Path("/etc/shadow")

# How an image declares the accounts its packages created. "sysusers" leaves
# them in /etc and has systemd-sysusers recreate what is missing at every boot.
# "userdb" moves the users into /usr as JSON records nss-systemd resolves, out
# of /etc entirely, so no /etc merge can lose one or leave it at a stale UID.
#
# Groups stay in /etc under either mode. The drop-in backend answers lookups by
# name and by id but not membership queries, so a group only it knows about
# never reaches initgroups(3), and a daemon started with User= would silently
# lose its supplementary groups.
ACCOUNT_MODES = ("sysusers", "userdb")

# base-passwd puts nobody above UID_MIN, so the human account check exempts it.
NOBODY_UID = 65534

# The floor for human accounts when /etc/login.defs does not name one.
DEFAULT_UID_MIN = 1000

# sysusers.d line types, in the order they have to be applied: a user's primary
# group must exist before the user, and both before a membership.
SYSUSERS_ORDER = {"g": 0, "u": 1, "m": 2}

# systemd unquotes a sysusers.d field, so a quote in a GECOS has to be escaped.
GECOS_ESCAPES = {ord('"'): '\\"', ord("\\"): "\\\\"}


class Account(NamedTuple):
    """One /etc/passwd entry."""

    name: str
    uid: int
    gid: int
    gecos: str
    home: str
    shell: str


class Group(NamedTuple):
    """One /etc/group entry."""

    name: str
    gid: int
    members: tuple[str, ...]


class Declared(NamedTuple):
    """What the sysusers.d files and userdb records already account for.

    An id is None where the declaration leaves it to be allocated at boot,
    which is only safe for an account that owns nothing in the image.
    """

    users: dict[str, int | None]
    groups: dict[str, int | None]
    memberships: set[tuple[str, str]]


class Additions(NamedTuple):
    """The accounts an image added on top of what is already declared."""

    users: list[Account]
    groups: list[Group]
    memberships: list[tuple[str, str]]


def read_accounts() -> list[Account]:
    """Read the accounts /etc/passwd lists.

    Returns:
        Every account, in file order.
    """
    accounts = []
    for line in PASSWD.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        name, _, uid, gid, gecos, home, shell = line.split(":")
        accounts.append(Account(name, int(uid), int(gid), gecos, home, shell))
    return accounts


def read_groups() -> list[Group]:
    """Read the groups /etc/group lists.

    Returns:
        Every group, in file order.
    """
    groups = []
    for line in GROUP.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        name, _, gid, members = line.split(":")
        groups.append(Group(name, int(gid), tuple(filter(None, members.split(",")))))
    return groups


def read_secrets(path: Path) -> dict[str, str]:
    """Read the password field of a shadow-style file.

    Returns:
        Each name and the password field recorded for it.
    """
    if not path.is_file():
        return {}
    entries = {}
    for line in path.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        name, secret = line.split(":")[:2]
        entries[name] = secret
    return entries


def is_locked(secret: str) -> bool:
    """Report whether a shadow password field holds no usable hash.

    Returns:
        True when the field is empty or only the characters that lock an account.
    """
    return secret.strip("!*") == ""


def uid_min() -> int:
    """Read the lowest UID useradd hands to a human account.

    Returns:
        UID_MIN from /etc/login.defs, or the compiled-in default.
    """
    if LOGIN_DEFS.is_file():
        for line in LOGIN_DEFS.read_text().splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[0] == "UID_MIN":
                return int(fields[1])
    return DEFAULT_UID_MIN


def sysusers_id(field: str) -> int | None:
    """Read the id a sysusers.d id field pins.

    Returns:
        The numeric id, or None where the field defers it to allocation.
    """
    value = field.split(":", maxsplit=1)[0]
    return int(value) if value.isdigit() else None


class OwnedPath(NamedTuple):
    """Something the image ships that records an account in its ownership."""

    path: Path
    uid: int
    gid: int


def image_owned_paths() -> list[OwnedPath]:
    """Find everything the image ships that is not owned by root.

    Ownership is stored as a number, so each of these is a place an account's
    id escapes into the image.

    Returns:
        Each path and the ids owning it, topmost first.
    """
    owned = []
    stack = [tree for tree in OWNED_TREES if tree.is_dir()]
    while stack:
        with os.scandir(stack.pop()) as entries:
            for entry in entries:
                info = entry.stat(follow_symlinks=False)
                if info.st_uid or info.st_gid:
                    owned.append(OwnedPath(Path(entry.path), info.st_uid, info.st_gid))
                if entry.is_dir(follow_symlinks=False):
                    stack.append(Path(entry.path))
    return sorted(owned)


def unreachable_owner_ids(owned: list[OwnedPath]) -> tuple[set[int], set[int]]:
    """Collect the ids no boot-time chown can correct.

    A path under /etc gets a tmpfiles.d entry that resolves its owner by name
    at every boot, so its id may drift harmlessly. /usr is read-only, and
    package manager territory besides, so an id recorded there has to be
    pinned. /usr/bin/ssh-agent being setgid _ssh is the sharp case.

    Returns:
        The UIDs and GIDs recorded where only a stable id will do.
    """
    uids = {o.uid for o in owned if o.uid and not o.path.is_relative_to(ETC)}
    gids = {o.gid for o in owned if o.gid and not o.path.is_relative_to(ETC)}
    return uids, gids


def write_chown_rules(owned: list[OwnedPath]) -> None:
    """Have tmpfiles.d reassert the ownership of /etc by name at every boot.

    This is what lets those accounts keep floating ids: the number in the
    image stops mattering, because the machine resolves the name itself.

    The entries are "z" rather than "Z", one per path, so each restates
    exactly the ownership the image ships. A recursive "Z" on a directory
    would reach files below it that root owns, /etc/ppp being the case in
    point, and hand them to the directory's group.
    """
    entries = []
    for owner in owned:
        if not owner.path.is_relative_to(ETC):
            continue
        user, group = name_of(owner.uid, owner.gid)
        entries.append(f"z {tmpfiles_path(owner.path)} - {user} {group} -")

    header = (
        "# Ownership under /etc that the image records as a number, reasserted\n"
        "# by name so the id itself does not have to stay put. Generated by\n"
        "# bootc-ubuntu-imagectl.\n"
    )
    CHOWN_TMPFILES.write_text(header + "\n".join(entries) + "\n")
    CHOWN_TMPFILES.chmod(0o644)
    print(f"Reasserting {len(entries)} owned paths under {ETC} by name.")


def declared_names() -> Declared:
    """Collect the accounts something in the image already declares.

    Both the sysusers.d files packages ship and the userdb records an earlier
    finalize wrote count, so a derived image declares only its own additions.

    Returns:
        The declared users, groups and memberships, with the ids they pin.
    """
    users: dict[str, int | None] = {}
    groups: dict[str, int | None] = {}
    memberships: set[tuple[str, str]] = set()

    if USERDB.is_dir():
        for record in USERDB.glob("*.user"):
            # The numeric lookup symlinks point at a record already read.
            if not record.is_symlink():
                users[record.stem] = json.loads(record.read_text()).get("uid")

    for fields in dropin_fields(SYSUSERS_D):
        if len(fields) >= 2:
            kind, name = fields[0].rstrip("!"), fields[1].split(":", maxsplit=1)[0]
            ident = sysusers_id(fields[2]) if len(fields) > 2 else None
            if kind == "u":
                # setdefault, because systemd takes the first declaration of a
                # name in filename order and ignores the rest.
                users.setdefault(name, ident)
                # A u line creates a group of the same name unless its id field
                # names a different one.
                if len(fields) < 3 or ":" not in fields[2]:
                    groups.setdefault(name, ident)
            elif kind == "g":
                groups.setdefault(name, ident)
            elif kind == "m" and len(fields) >= 3:
                memberships.add((name, fields[2]))
    return Declared(users, groups, memberships)


def accounts_to_declare(owners: tuple[set[int], set[int]]) -> Additions:
    """Find the accounts this image has to declare the ids of itself.

    That is the ones nothing declares, plus the ones a package declares without
    pinning an id while the image records that id in a file's ownership.

    Args:
        owners: The UIDs and GIDs that own something the image ships.

    Returns:
        The users, groups and memberships this image has to declare itself.
    """
    declared = declared_names()
    owner_uids, owner_gids = owners
    floor = uid_min()

    users = []
    for account in sorted(read_accounts()):
        if account.name in declared.users:
            pinned = declared.users[account.name]
            if pinned == account.uid:
                continue
            if pinned is not None:
                fail(
                    f"{account.name} is declared with uid {pinned} but this "
                    f"build allocated {account.uid}."
                )
            # Declared without an id, which only matters if one was recorded.
            if account.uid not in owner_uids:
                continue
        elif account.uid >= floor and account.uid != NOBODY_UID:
            fail(
                f"{account.name} (uid {account.uid}) looks like a human account; "
                "provision one at boot with a credential instead of shipping it."
            )
        users.append(account)

    all_groups = read_groups()
    groups = []
    for group in sorted(all_groups):
        if group.name in declared.groups:
            pinned = declared.groups[group.name]
            if pinned == group.gid:
                continue
            if pinned is not None:
                fail(
                    f"{group.name} is declared with gid {pinned} but this "
                    f"build allocated {group.gid}."
                )
            if group.gid not in owner_gids:
                continue
        groups.append(group)

    known = {account.name for account in read_accounts()}
    memberships = sorted(
        (member, group.name)
        for group in all_groups
        for member in group.members
        # A member with no account cannot be recreated, and sysusers rejects it.
        if member in known and (member, group.name) not in declared.memberships
    )
    return Additions(users, groups, memberships)


# --- The id registry ---


def registered_ids() -> dict[tuple[str, str], int]:
    """Read the ids the registry fragments pin.

    The fragments are passwd and group files, so the registry is literally the
    thing it describes, the way Ubuntu Core and the Fedora bootc base image
    both keep theirs.

    Returns:
        The registered id, keyed by the line type and the name.
    """
    registered: dict[tuple[str, str], int] = {}
    if not REGISTRY_D.is_dir():
        return registered
    for kind, suffix in (("u", "*.passwd"), ("g", "*.group")):
        for fragment in sorted(REGISTRY_D.glob(suffix)):
            for line in fragment.read_text().splitlines():
                if not line or line.startswith("#"):
                    continue
                fields = line.split(":")
                if len(fields) >= 3:
                    registered[kind, fields[0]] = int(fields[2])
    return registered


def registry_entries(additions: Additions) -> list[tuple[tuple[str, str], str]]:
    """Render what this build created as the lines the registry would hold.

    Returns:
        Each registry key and the passwd or group entry describing it.
    """
    entries = [
        (
            ("u", a.name),
            f"{a.name}:x:{a.uid}:{a.gid}:{a.gecos}:{a.home}:{a.shell}",
        )
        for a in additions.users
    ]
    return entries + [(("g", g.name), f"{g.name}:x:{g.gid}:") for g in additions.groups]


def check_registry(additions: Additions, owners: tuple[set[int], set[int]]) -> None:
    """Fail when the built image disagrees with the registered ids.

    Every registered entry is checked, not just the ones this image declares,
    so the registry is a contract about the whole account database rather than
    an observation of part of it. An id that moves between two builds leaves a
    machine that upgraded between them disagreeing with the file ownership the
    image ships, and sysusers never renumbers an account a machine already has.
    """
    registered = registered_ids()
    built = {("u", a.name): a.uid for a in read_accounts()}
    built |= {("g", g.name): g.gid for g in read_groups()}

    drifted = []
    absent = []
    for key, ident in sorted(registered.items()):
        kind, name = key
        if key not in built:
            absent.append(f"{kind} {name} {ident}")
        elif built[key] != ident:
            drifted.append(
                f"{kind} {name}: registered as {ident}, "
                f"this build allocated {built[key]}"
            )
    # Only an account that owns something needs registering. Reporting the
    # rest would bury the ones that matter under everything that may drift
    # harmlessly.
    owner_uids, owner_gids = owners
    unregistered = [
        entry
        for (kind, name), entry in registry_entries(additions)
        if (kind, name) not in registered
        and int(entry.split(":")[2]) in (owner_uids if kind == "u" else owner_gids)
    ]

    if drifted:
        listing = "\n  ".join(drifted)
        fail(
            f"the ids below moved since they were registered in {REGISTRY_D}:"
            f"\n  {listing}\nbootc-ubuntu-seed-accounts is what holds them "
            "still; check it ran before the packages installed. Only change a "
            "registered id if no released image has shipped the old one."
        )
    if absent:
        listing = "\n  ".join(absent)
        print(
            f"Registered in {REGISTRY_D} but not in this image, so a package "
            f"that created them is gone:\n  {listing}"
        )
    if unregistered:
        listing = "\n  ".join(unregistered)
        fail(
            f"the accounts below own something under /usr, which is read-only, "
            f"so nothing can correct their ownership once an id moves. Add "
            f"these lines to the passwd and group fragments in {REGISTRY_D}:"
            f"\n  {listing}"
        )


# --- sysusers.d ---


def sysusers_gecos(gecos: str) -> str:
    """Format a GECOS for the description field of a sysusers.d line.

    Returns:
        The description, quoted, or "-" when the account has none.
    """
    return f'"{gecos.translate(GECOS_ESCAPES)}"' if gecos else "-"


def sysusers_lines(additions: Additions, with_users: bool) -> list[str]:
    """Render the additions as sysusers.d lines.

    Args:
        additions: The accounts to declare.
        with_users: Whether to declare the users too, or only the groups and
            memberships, the users being declared as userdb records instead.

    Returns:
        One line per group, user and membership.
    """
    lines = [f"g {group.name} {group.gid}" for group in additions.groups]
    if with_users:
        lines += [
            f"u {account.name} {account.uid}:{account.gid} "
            f"{sysusers_gecos(account.gecos)} "
            f"{account.home or '-'} {account.shell or '-'}"
            for account in additions.users
        ]
    lines += [f"m {user} {group}" for user, group in additions.memberships]
    return lines


def write_sysusers(additions: Additions, with_users: bool) -> None:
    """Declare the added accounts in sysusers.d, for every boot to recreate.

    What is declared here stays in /etc, where a machine's own edits and an
    upgrade's three-way merge can reach it. What this buys is that an entry the
    merge drops comes back at the next boot, with the id the image built it with.

    Args:
        additions: The accounts to declare.
        with_users: Whether the users belong here, or in the userdb records.
    """
    kept: list[str] = []
    if GENERATED_SYSUSERS.is_file():
        # Written by an earlier finalize. declared_names() already skipped
        # these, so scanning /etc alone would drop them.
        kept = [
            line
            for line in GENERATED_SYSUSERS.read_text().splitlines()
            if line and not line.startswith("#")
        ]

    # Sorting on the line type first keeps a group ahead of the user whose
    # primary group it is, and both ahead of a membership naming them.
    ordered = sorted(
        (SYSUSERS_ORDER.get(line.split()[0].rstrip("!"), len(SYSUSERS_ORDER)), line)
        for line in set(kept + sysusers_lines(additions, with_users))
    )
    lines = [line for _, line in ordered]
    header = (
        "# The accounts the image's packages created, with the UIDs and GIDs\n"
        "# they were built with. Generated by bootc-ubuntu-imagectl.\n"
    )
    GENERATED_SYSUSERS.parent.mkdir(parents=True, exist_ok=True)
    GENERATED_SYSUSERS.write_text(header + "\n".join(lines) + "\n")
    GENERATED_SYSUSERS.chmod(0o644)


# --- userdb records ---


def require_nss_systemd() -> None:
    """Fail unless glibc resolves userdb records, which userdb mode needs."""
    if not any(Path("/usr/lib").glob("*/libnss_systemd.so.2")):
        fail("userdb accounts need the libnss-systemd package installed.")
    for line in NSSWITCH.read_text().splitlines():
        if line.startswith("passwd:") and "systemd" in line.split():
            return
    fail(f"userdb accounts need systemd on the passwd line of {NSSWITCH}.")


def write_record(path: Path, record: dict[str, object], key: int) -> None:
    """Write one userdb record, with the symlink that makes it resolve by id.

    nss-systemd looks a record up by name from the file name. Only the symlink
    makes the reverse lookup work, without which ls prints bare numbers and
    useradd cannot see the id is taken.
    """
    path.write_text(json.dumps(record, indent=4, sort_keys=True) + "\n")
    path.chmod(0o644)
    by_id = path.with_name(f"{key}{path.suffix}")
    by_id.unlink(missing_ok=True)
    by_id.symlink_to(path.name)


def write_userdb(additions: Additions) -> None:
    """Declare the added users as userdb records under /usr.

    This takes them out of /etc altogether: they become image content, so an
    upgrade brings them along the way it brings any other file, and a machine
    cannot end up short an account the image has, or holding one at a UID the
    image never gave it.

    Memberships are left to sysusers.d, since a record's memberOf is not
    something the drop-in backend reports.
    """
    secrets = read_secrets(SHADOW)
    for account in additions.users:
        if not is_locked(secrets.get(account.name, "")):
            fail(
                f"{account.name} has a password set, which a userdb record does "
                "not carry; move it out of /etc/shadow by hand."
            )

    USERDB.mkdir(parents=True, exist_ok=True)
    USERDB.chmod(0o755)

    for account in additions.users:
        record: dict[str, object] = {
            "userName": account.name,
            "uid": account.uid,
            "gid": account.gid,
            "disposition": "system",
            "locked": True,
        }
        if account.gecos:
            record["realName"] = account.gecos
        if account.home:
            record["homeDirectory"] = account.home
        if account.shell:
            record["shell"] = account.shell
        write_record(USERDB / f"{account.name}.user", record, account.uid)


def strip_users(additions: Additions) -> None:
    """Remove the users now declared under /usr from the /etc database.

    /etc/group is left alone, both because its entries are declared in
    sysusers.d rather than moved, and because its member lists are what carries
    a moved user's supplementary groups into initgroups(3).
    """
    moved = {account.name for account in additions.users}
    for path in (PASSWD, SHADOW):
        if not path.is_file():
            continue
        kept = [
            line
            for line in path.read_text().splitlines()
            if not line or line.startswith("#") or line.split(":")[0] not in moved
        ]
        # Truncating in place keeps the mode and owner, which /etc/shadow needs.
        path.write_text("\n".join(kept) + "\n")


def declare_accounts(mode: str) -> None:
    """Declare the accounts the packages created outside of /etc state."""
    step(f"declaring the accounts the packages created ({mode})")
    owned = image_owned_paths()
    write_chown_rules(owned)
    owners = unreachable_owner_ids(owned)
    additions = accounts_to_declare(owners)
    check_registry(additions, owners)
    if mode == "userdb":
        require_nss_systemd()
        write_userdb(additions)
        strip_users(additions)
    write_sysusers(additions, with_users=mode != "userdb")
    print(
        f"Declared {len(additions.users)} users, {len(additions.groups)} groups "
        f"and {len(additions.memberships)} memberships."
    )


# --- Subcommands ---


def cmd_cleanup(args: Args) -> None:
    """Strip build-time state and lay out the rootfs the way bootc expects."""
    label_components(DPKG_ADMINDIR)
    relocate_image_state()
    remove_machine_identity()
    layout_toplevel()
    patch_stock_tmpfiles()
    relocate_font_cache()
    write_var_tmpfiles()
    # After write_var_tmpfiles, which names the owners of the /var directories
    # it records by reading /etc/passwd, and which userdb mode empties.
    declare_accounts(args.accounts)
    empty_var()


def cmd_lint(args: Args) -> None:
    """Run bootc container lint with warnings fatal."""
    step("linting")
    subprocess.run(["bootc", "container", "lint", "--fatal-warnings"], check=True)


def cmd_finalize(args: Args) -> None:
    """Run initramfs, cleanup and lint, in that order."""
    cmd_initramfs(args)
    cmd_cleanup(args)
    cmd_lint(args)


def cmd_rechunk(args: Args) -> None:
    r"""Repack an image into content-based layers with chunkah.

    Runs from the image itself, with the image to repack mounted at /chunkah.
    Writes an OCI archive to stdout, or an OCI layout given --output, which
    avoids tarring and untarring the whole image:

        podman run --rm --mount=type=image,src=IMAGE,dst=/chunkah \
            -e CHUNKAH_CONFIG_STR="$(podman inspect IMAGE)" -v "$PWD:/out:z" \
            IMAGE /usr/libexec/bootc-ubuntu-imagectl rechunk \
                --output oci:/out/layout --tag IMAGE
        podman pull "oci:$PWD/layout:IMAGE"

    Image configuration must be handed to chunkah through CHUNKAH_CONFIG_STR.
    """
    if not (CHUNKAH_ROOTFS / "usr").is_dir():
        fail(f"no rootfs mounted at {CHUNKAH_ROOTFS}")
    if "CHUNKAH_CONFIG_STR" not in os.environ:
        if args.tag:
            fail("CHUNKAH_CONFIG_STR unset, the image would lose its labels")
        step("CHUNKAH_CONFIG_STR unset, the image loses its labels")
    command = [
        "chunkah",
        "build",
        "--rootfs",
        str(CHUNKAH_ROOTFS),
        "--max-layers",
        str(args.max_layers),
        "--source-date-epoch",
        str(args.source_date_epoch),
    ]
    if args.output:
        command += ["--output", args.output]
    if args.tag:
        command += ["--tag", args.tag]
    for path in args.prune:
        command += ["--prune", path]
    os.execvp(command[0], command)


# --- Command line ---


class Args(argparse.Namespace):
    """The parsed command line, typed."""

    func: Callable[[Args], None]
    accounts: str
    max_layers: int
    source_date_epoch: int
    output: str | None
    prune: list[str]
    tag: str | None


def parse_args() -> Args:
    """Parse the command line.

    Returns:
        The parsed arguments, with the chosen subcommand in `func`.
    """
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    commands = parser.add_subparsers(required=True, metavar="COMMAND")

    parsers = {}
    for name, func in (
        ("initramfs", cmd_initramfs),
        ("cleanup", cmd_cleanup),
        ("lint", cmd_lint),
        ("finalize", cmd_finalize),
    ):
        sub = commands.add_parser(name, help=summary(func))
        sub.set_defaults(func=func, accounts=ACCOUNT_MODES[0])
        parsers[name] = sub

    for name in ("cleanup", "finalize"):
        parsers[name].add_argument(
            "--accounts",
            choices=ACCOUNT_MODES,
            default=ACCOUNT_MODES[0],
            help="where the accounts packages created are declared "
            "(default: %(default)s)",
        )

    rechunk = commands.add_parser(
        "rechunk",
        help=summary(cmd_rechunk),
        description=cmd_rechunk.__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    rechunk.add_argument(
        "--max-layers",
        type=int,
        default=128,
        help="layers to pack into (default: %(default)s)",
    )
    rechunk.add_argument(
        "--source-date-epoch",
        type=int,
        default=0,
        metavar="SECONDS",
        help="timestamp for the layers and the files in them (default: %(default)s)",
    )
    rechunk.add_argument(
        "--output",
        metavar="[oci:|oci-archive:]PATH",
        help="write the image here instead of to stdout",
    )
    rechunk.add_argument(
        "--prune",
        action="append",
        default=[],
        metavar="PATH",
        help="exclude PATH from the image, may be repeated",
    )
    rechunk.add_argument("--tag", help="name podman load gives the image")
    rechunk.set_defaults(func=cmd_rechunk)
    return parser.parse_args(namespace=Args())


def main() -> None:
    """Run the requested subcommand."""
    if os.geteuid() != 0:
        fail("must run as root")
    args = parse_args()
    try:
        args.func(args)
    except subprocess.CalledProcessError as error:
        fail(f"{error.cmd[0]} failed with exit status {error.returncode}")


if __name__ == "__main__":
    main()
