#!/usr/bin/env python3
r"""Install this image onto a disk, with an optionally LUKS2-encrypted root.

Run this from the bootc image as a container, against a disk on the
host:

    podman run --rm -it --privileged --pid=host --ipc=host \
      -v /dev:/dev -v /run/udev:/run/udev:ro \
      IMAGE /usr/libexec/bootc-ubuntu-install /dev/nvme0n1
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from enum import StrEnum
from getpass import getpass
from pathlib import Path

# Discoverable Partitions Specification type GUIDs, as written by repart.d.
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
ROOT_TYPE = "4f68bce3-e8cd-4db1-96e7-fbcaf984b709"

DEFINITIONS = Path("/usr/lib/bootc-ubuntu/repart.d")
ROOT_DEFINITION = "20-root.conf"
MAPPING = "bootc-ubuntu-root"


class EncryptMode(StrEnum):
    """How the root is encrypted, as systemd-repart Encrypt= values."""

    # TODO: add key-file+tpm2, which repart enrolls against the installer
    # machine's TPM and no PCRs.
    OFF = "off"
    KEY_FILE = "key-file"


def partition_of_type(device: Path, type_guid: str) -> Path:
    """Find a partition by its type GUID, reading the partition table directly.

    sfdisk reads the disk itself, so the lookup does not depend on udev having
    caught up with the new partitions. wait_for does that part.

    Returns:
        The path of the matching partition.
    """
    out = subprocess.run(
        ["sfdisk", "--json", device],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    for part in json.loads(out)["partitiontable"]["partitions"]:
        if part.get("type", "").lower() == type_guid:
            return Path(part["node"])
    sys.exit(f"no partition of type {type_guid} on {device}.")


def wait_for(node: Path, timeout: int = 10) -> Path:
    """Wait for udev to create a partition's device symlink.

    Returns:
        The path, once it exists.
    """
    subprocess.run(["udevadm", "wait", f"--timeout={timeout}", node], check=True)
    return node


def repart_definitions(tmp: Path, encrypt: EncryptMode) -> Path:
    """Copy the repart definitions, setting how the root is encrypted.

    The shipped definitions carry no Encrypt=, so the mode is appended to a
    copy of the root definition.

    Returns:
        The path of the copied definitions directory.
    """
    copied = tmp / DEFINITIONS.name
    shutil.copytree(DEFINITIONS, copied)
    root = copied / ROOT_DEFINITION
    root.write_text(f"{root.read_text()}Encrypt={encrypt}\n")
    return copied


def prompt_passphrase() -> str:
    """Ask for the passphrase the encrypted root is unlocked with.

    Returns:
        The confirmed passphrase.
    """
    passphrase = getpass("Passphrase for the encrypted root: ")
    if not passphrase:
        sys.exit("Passphrase must not be empty.")
    if passphrase != getpass("Repeat passphrase: "):
        sys.exit("Passphrases do not match.")
    return passphrase


def confirm(device: Path) -> None:
    """Show what the install destroys, and make the user type the disk name."""
    print(f"This destroys every partition on {device}:")
    subprocess.run(["lsblk", "--output", "NAME,SIZE,FSTYPE,LABEL", device], check=False)
    if input(f"Type {device} to confirm: ").strip() != str(device):
        sys.exit("Aborted.")


class Args(argparse.Namespace):
    """The parsed command line, typed."""

    device: Path
    source_imgref: str | None
    target_imgref: str | None
    encrypt: EncryptMode


def parse_args() -> Args:
    """Parse the command line.

    Returns:
        The parsed arguments.
    """
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("device", type=Path, help="Disk to install to.")
    parser.add_argument(
        "--source-imgref",
        help="Image to install, in containers-transports(5) form, such as "
        "docker://docker.io/example/bootc-ubuntu:26.04. Defaults to the image "
        "this is running from.",
    )
    parser.add_argument(
        "--target-imgref",
        help="Registry reference the installed system fetches updates from, such "
        "as docker.io/example/bootc-ubuntu:26.04. Defaults to the source.",
    )
    parser.add_argument(
        "--encrypt",
        type=EncryptMode,
        choices=list(EncryptMode),
        default=EncryptMode.KEY_FILE,
        help="How to encrypt the root. key-file asks for a passphrase, off "
        "leaves the root unencrypted. Default: %(default)s.",
    )
    return parser.parse_args(namespace=Args())


def install(
    device: Path,
    source_imgref: str | None,
    target_imgref: str | None,
    encrypt: EncryptMode,
    keyfile: Path | None,
    tmp: Path,
    target: Path,
) -> None:
    """Partition the disk, encrypt the root as asked, and install the image."""
    print(f"Partitioning {device}")
    subprocess.run(
        [
            "systemd-repart",
            f"--definitions={repart_definitions(tmp, encrypt)}",
            "--empty=force",
            "--dry-run=no",
            *([f"--key-file={keyfile}"] if keyfile else []),
            device,
        ],
        check=True,
        # composefs verifies the deployment with fs-verity, and repart does not
        # enable the ext4 feature by default.
        env=os.environ | {"SYSTEMD_REPART_MKFS_OPTIONS_EXT4": "-O verity"},
    )

    esp = wait_for(partition_of_type(device, ESP_TYPE))
    root = wait_for(partition_of_type(device, ROOT_TYPE))

    filesystem = root
    if keyfile:
        print(f"Unlocking {root}")
        subprocess.run(
            ["cryptsetup", "luksOpen", root, MAPPING, f"--key-file={keyfile}"],
            check=True,
        )
        filesystem = Path("/dev/mapper") / MAPPING
    subprocess.run(["mount", filesystem, target], check=True)

    # Left to bootc when not given, which reads the image this is running from.
    extra: list[str] = []
    if source_imgref:
        extra.append(f"--source-imgref={source_imgref}")
    if target_imgref:
        extra.append(f"--target-imgref={target_imgref}")
    elif source_imgref and not source_imgref.startswith(("docker://", "registry:")):
        print(
            "Warning: no target_imgref and source_imgref is not a registry "
            "reference, so the installed system will have no usable update source.",
            file=sys.stderr,
        )

    print(f"Installing {source_imgref or 'this image'}")
    subprocess.run(
        [
            "bootc",
            "install",
            "to-filesystem",
            "--composefs-backend",
            *extra,
            target,
        ],
        check=True,
    )

    if not keyfile:
        print(f"\nInstalled. ESP {esp}, unencrypted root {root}.")
        return
    print(f"\nInstalled. ESP {esp}, encrypted root {root}.")
    print("Add a TPM2 keyslot once Secure Boot is enabled with:")
    print(f"  systemd-cryptenroll --tpm2-device=auto {root}.")


def main() -> None:
    """Install the image, from the command line."""
    args = parse_args()

    if os.geteuid() != 0:
        sys.exit("This script must run as root.")
    if not args.device.is_block_device():
        sys.exit(f"{args.device} is not a block device.")

    confirm(args.device)
    passphrase = prompt_passphrase() if args.encrypt != EncryptMode.OFF else None

    # Kept out of /tmp, where bootc install mounts a fresh tmpfs when it is not
    # one already, as in a container, and that would shadow the target mount.
    with tempfile.TemporaryDirectory(dir="/run") as tmp:
        keyfile = None
        if passphrase is not None:
            # repart takes the key from a file. Writing the passphrase with no
            # trailing newline makes the resulting keyslot an ordinary passphrase.
            keyfile = Path(tmp) / "passphrase"
            keyfile.write_text(passphrase)
            keyfile.chmod(0o600)

        target = Path(tmp) / "target"
        target.mkdir()
        try:
            install(
                args.device,
                args.source_imgref,
                args.target_imgref,
                args.encrypt,
                keyfile,
                Path(tmp),
                target,
            )
        finally:
            subprocess.run(["umount", "--recursive", target], check=False)
            if keyfile:
                subprocess.run(["cryptsetup", "close", MAPPING], check=False)

    print(f"\nBoot {args.device} to start the new system.")


if __name__ == "__main__":
    main()
